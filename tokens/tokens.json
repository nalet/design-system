{
  "$schema": "https://designtokens.org/tr/drafts/format/",
  "$description": "nalet design tokens. Single source of truth: tokens/tokens.json.",
  "color": {
    "canvas": {
      "bg":        { "$value": "#0B0F19", "$type": "color", "$description": "Primary background, deepest canvas" },
      "bg-2":      { "$value": "#0D1117", "$type": "color", "$description": "Deeper recesses, terminal blocks" },
      "surface":   { "$value": "#11161F", "$type": "color", "$description": "Cards, panels, raised areas" },
      "surface-2": { "$value": "#161B26", "$type": "color", "$description": "Hover state on surface" },
      "border":    { "$value": "#1F2633", "$type": "color", "$description": "Hairline borders, dividers" },
      "border-2":  { "$value": "#2A3142", "$type": "color", "$description": "Heavier dividers" },
      "surface-selected": { "$value": "#111B2A", "$type": "color", "$description": "Selected row or item; dark enough that every text token keeps 4.5:1" }
    },
    "foreground": {
      "fg":       { "$value": "#E6E6E6", "$type": "color", "$description": "Primary text, titles" },
      "fg-2":     { "$value": "#C9D1D9", "$type": "color", "$description": "Body text, the n glyph" },
      "fg-muted": { "$value": "#AEB8C2", "$type": "color", "$description": "Labels, meta, captions" },
      "fg-dim":   { "$value": "#7B8597", "$type": "color", "$description": "Helpers, hints, 'off'; the dimmest text that still meets 4.5:1 on every background" }
    },
    "brand": {
      "cloud-blue": { "$value": "#58A6FF", "$type": "color", "$description": "Chevron, links, primary CTA" },
      "cloud-cyan": { "$value": "#00A4DC", "$type": "color", "$description": "Cursor, active stroke" }
    },
    "signal": {
      "green": { "$value": "#2EA043", "$type": "color", "$description": "ok / running / healthy" },
      "amber": { "$value": "#F2B233", "$type": "color", "$description": "warn / delayed / degraded" },
      "red":   { "$value": "#F85149", "$type": "color", "$description": "error / failed / offline" }
    },
    "control": {
      "border-control": { "$value": "#646C7A", "$type": "color", "$description": "Boundary of an input, select or checkbox; 3:1 on every background (WCAG 1.4.11)" },
      "focus-ring":     { "$value": "{color.brand.cloud-cyan}", "$type": "color", "$description": "Keyboard focus outline" }
    },
    "state": {
      "neutral":            { "$value": "{color.foreground.fg-muted}", "$type": "color", "$description": "No judgement: a plain fact or state (missing, queued)" },
      "neutral-bg":         { "$value": "{color.canvas.surface-2}",    "$type": "color", "$description": "Neutral chip and banner background" },
      "neutral-border":     { "$value": "{color.canvas.border-2}",     "$type": "color", "$description": "Neutral chip border" },
      "information":        { "$value": "{color.brand.cloud-blue}",    "$type": "color", "$description": "Under way or worth knowing; nothing to fix (on its way, syncing)" },
      "information-bg":     { "$value": "#15202E", "$type": "color", "$description": "10% information over bg-2" },
      "information-border": { "$value": "#3F6697", "$type": "color", "$description": "45% information over border-2" },
      "success":            { "$value": "{color.signal.green}",        "$type": "color", "$description": "Done and good (held, healthy, saved); never for a problem" },
      "success-bg":         { "$value": "#101F1B", "$type": "color", "$description": "10% success over bg-2" },
      "success-border":     { "$value": "#2C6342", "$type": "color", "$description": "45% success over border-2" },
      "warning":            { "$value": "{color.signal.amber}",        "$type": "color", "$description": "Works, but not fully; someone should look (firewalled, degraded)" },
      "warning-bg":         { "$value": "#24211A", "$type": "color", "$description": "10% warning over bg-2" },
      "warning-border":     { "$value": "#846B3B", "$type": "color", "$description": "45% warning over border-2" },
      "error":              { "$value": "{color.signal.red}",          "$type": "color", "$description": "Failed or blocked; needs action (needs attention, offline)" },
      "error-bg":           { "$value": "#25171C", "$type": "color", "$description": "10% error over bg-2" },
      "error-border":       { "$value": "#873F45", "$type": "color", "$description": "45% error over border-2" }
    }
  },
  "type": {
    "family": {
      "ui":   { "$value": "Inter, system-ui, sans-serif",          "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, monospace", "$type": "fontFamily" }
    },
    "role": {
      "display":  { "$value": { "fontFamily": "{type.family.mono}", "fontWeight": 800, "fontSize": "56px", "lineHeight": "1.00", "letterSpacing": "-0.030em" }, "$type": "typography" },
      "h1":       { "$value": { "fontFamily": "{type.family.mono}", "fontWeight": 700, "fontSize": "32px", "lineHeight": "1.15", "letterSpacing": "-0.015em" }, "$type": "typography" },
      "h2":       { "$value": { "fontFamily": "{type.family.mono}", "fontWeight": 600, "fontSize": "22px", "lineHeight": "1.20", "letterSpacing": "0" }, "$type": "typography" },
      "body":     { "$value": { "fontFamily": "{type.family.ui}",   "fontWeight": 400, "fontSize": "16px", "lineHeight": "1.55", "letterSpacing": "0" }, "$type": "typography" },
      "ui":       { "$value": { "fontFamily": "{type.family.ui}",   "fontWeight": 500, "fontSize": "13px", "lineHeight": "1.40", "letterSpacing": "0" }, "$type": "typography" },
      "code":     { "$value": { "fontFamily": "{type.family.mono}", "fontWeight": 500, "fontSize": "13px", "lineHeight": "1.50", "letterSpacing": "0" }, "$type": "typography" }
    }
  },
  "space": {
    "s-1": { "$value": "4px",  "$type": "dimension" },
    "s-2": { "$value": "8px",  "$type": "dimension" },
    "s-3": { "$value": "12px", "$type": "dimension" },
    "s-4": { "$value": "16px", "$type": "dimension" },
    "s-5": { "$value": "24px", "$type": "dimension" },
    "s-6": { "$value": "32px", "$type": "dimension" },
    "s-7": { "$value": "48px", "$type": "dimension" },
    "s-8": { "$value": "64px", "$type": "dimension" }
  }
}
