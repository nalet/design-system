{
  "name": "@nalet/design-system",
  "version": "0.3.0",
  "description": "nalet design system — dark canvas, monospace voice, blue chevron, square frames. Tokens + React components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "tokens/tokens.json",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/assets/index.css",
    "./tailwind": "./tailwind-preset.cjs",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build-tokens": "node tokens/build.mjs",
    "prebuild": "node tokens/build.mjs",
    "build": "node tokens/build.mjs && vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "site:dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --root site",
    "site:build": "ASTRO_TELEMETRY_DISABLED=1 astro build --root site && pagefind --site site/dist --output-subdir pagefind",
    "site:react": "STORYBOOK_BASE_PATH=/design-system/react/ storybook build --quiet --output-dir site/dist/react",
    "site:check": "node site/scripts/check-links.mjs",
    "site:preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --root site"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/react": "7.1.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "7.4.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.50.0",
    "pagefind": "1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
