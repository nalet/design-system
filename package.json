{
  "name": "@nalet/design-system",
  "version": "0.2.0",
  "description": "nalet design system — dark canvas, monospace voice, blue chevron, square frames. Tokens + React components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "tokens/tokens.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/assets/index.css",
    "./tailwind": "./tailwind-preset.cjs",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build-tokens": "node tokens/build.mjs",
    "prebuild": "node tokens/build.mjs",
    "build": "node tokens/build.mjs && vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
