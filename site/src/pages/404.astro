---
import Bare from '../layouts/Bare.astro';
import { url, REACT } from '../data/site';
---
<Bare title="not found" noindex>
  <article class="ds-prose">
    <h1>not found</h1>
    <p>there is no page at this address. it may have moved when the guidelines left the storybook.</p>
    <ul>
      <li><a href={url()}>the guidelines</a>, from the start</li>
      <li><a href={url('components/')}>every component</a></li>
      <li><a href={REACT}>the react subsite</a>: playgrounds, examples and props</li>
      <li><a href={url('search/')}>search</a></li>
    </ul>
  </article>
</Bare>
